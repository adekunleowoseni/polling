# Optional — only needed if your API is NOT at http://localhost:8000
# Copy to .env for local dev: cp .env.example .env

# Local backend (default if unset — no .env required)
# NUXT_PUBLIC_API_BASE=http://localhost:8000

# Production API on VPS (use when testing frontend locally against live backend)
# NUXT_PUBLIC_API_BASE=https://poll.edumatrix.com

# Google Maps JavaScript API key (same value as mobile EXPO_PUBLIC_GOOGLE_MAPS_API_KEY)
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
